# =====================================================================
# City Smile — dedicated CRM backend .env TEMPLATE
# Copy to BACKEND/.env on the City Smile server, then fill in.
# No secrets in this file. Paste secret values only on the server.
# Verified against every process.env.* read in this codebase (71 vars).
# =====================================================================

# ---------------------------------------------------------------------
# SINGLE-COMPANY LOCK + SUPER ADMIN LINK (REQUIRED, new)
# ---------------------------------------------------------------------
# This server's only company. The server refuses to start without it, or if
# the database holds any other company.
TENANT_ID=6a7c778ebbd0096700549944
# Shared with the Super Admin panel for /api/control. At least 32 characters.
# Generate:  openssl rand -hex 32   (empty = /api/control switched off)
CONTROL_SECRET=

# ---------------------------------------------------------------------
# GROUP A — NEW values for City Smile (do NOT copy from main)
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=production
TZ=Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# City Smile's own Atlas database
MONGO_URI=

# Generate on server:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# MUST be exactly 32 characters. Generate on server:  openssl rand -hex 16
COOKIE_ENCRYPTION_KEY=

# IP-only phase: http://<ELASTIC-IP>   |  after domain: https://crm.<domain> / https://api.<domain>
FRONTEND_ORIGIN=https://crm.citysmile.in
BACKEND_ORIGIN_PUBLIC=https://api.citysmile.in
BACKEND_PUBLIC_URL=https://api.citysmile.in

# Claude connector (src/mcp). The backend's public https origin as Claude
# reaches it, e.g. https://api.citysmile.in. Leave empty to keep it off.
MCP_PUBLIC_URL=

# City Smile's tenant _id (fallback for Meta lead webhooks)
META_LEAD_DEFAULT_TENANT_ID=6a7c778ebbd0096700549944

# Shown in WhatsApp auto-replies
BUSINESS_NAME=City Smile
SUPPORT_PHONE=

# Turns on HRMS scheduled jobs (daily alerts, auto-close punches, reminders). Must be "true".
ENABLE_CRON=true
# Protects /jobs endpoints. Generate on server:  openssl rand -hex 16
JOB_SECRET=

# ---------------------------------------------------------------------
# GROUP B — MUST be identical to the main server
# ---------------------------------------------------------------------
# Decrypts integration tokens copied from the main DB. Min 16 chars.
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# GROUP C — Shared API keys (copy from main .env, or swap for City Smile's own later)
# Usage on these is billed to whoever owns the key.
# ---------------------------------------------------------------------
# AI
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Meeting / call recordings (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
MEETING_RECORDINGS_S3_BUCKET=
CALLING_AGENT_S3_BUCKET=

# Salary template uploads (HRMS)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (HRMS mails). SMTP_SECURE=true only for port 465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Geocoding (attendance addresses) — any one is enough
GOOGLE_MAPS_API_KEY=
MAPPLS_API_KEY=
OLA_MAPS_API_KEY=

# Push notifications (mobile app) — use ONE of these
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Face attendance service (only if face attendance is used)
FACE_SERVICE_URL=
FACE_SERVICE_KEY=

# ---------------------------------------------------------------------
# GROUP D — Leave EMPTY now. Fill after domain + HTTPS, when WhatsApp/Meta is connected.
# Do NOT copy META_PAGE_ACCESS_TOKEN_<pageId> lines from main — those are other clients' pages.
# ---------------------------------------------------------------------
META_WEBHOOK_VERIFY_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
WA_GRAPH_VERSION=v21.0
# Calling agent (Exotel) webhook IP allowlist, comma-separated — only if used
EXOTEL_IP_ALLOWLIST=

# ---------------------------------------------------------------------
# OPTIONAL — code has sensible defaults; set only to change behaviour
# ---------------------------------------------------------------------
# Leave as true (default) until you've checked which tenants would be expired
# TENANT_EXPIRY_DRY_RUN=true
# LEAD_REMINDER_CRON=*/1 * * * *
# META_ADS_SYNC_CRON=15 */3 * * *
# WA_MONTHLY_CRON=0 10 1 * *
# CALLING_AGENT_WORKER_CRON=*/30 * * * * *
# CLOSE_PUNCHES_CRON=0 4 * * *
# DAILY_ALERT_CRON=
# ERP_REMINDERS_CRON=0 8 * * *
# TODO_CRON=0 * * * *
# MONTHLY_EDU_CRON=0 10 1 * *
# ADVANCE_SALARY_CAP_PERCENT=100
# LOAN_SALARY_MULTIPLE=10
# FACE_MATCH_THRESHOLD=0.42
# FACE_KIOSK_COOLDOWN_SECONDS=120
# GEOFENCE_MIN_FIXES=5
# GEOFENCE_MIN_SPAN_MS=90000
# GEOFENCE_GRACE_MS=60000
